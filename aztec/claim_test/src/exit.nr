//! Exits (TXE): leave to Solana (ADR 0009: `exit`, the exit epoch tree, `close_exit_epoch`) and
//! leave to Ethereum (ADR 0014 §4: `exit_to_ethereum`).
//!
//! TXE keeps no L2->L1 messages in its blocks, so these tests check the content a close records
//! (the value it hands to `message_portal`) and the content functions against the shared vectors.
//! scripts/s2-aztec/local-exit.ts reads the real messages from a local Aztec node and consumes them
//! through the real Outbox.

use crate::{exit_vectors as vectors, private_balance, Setup, setup_with};
use aztec::{
    protocol::{address::{AztecAddress, EthAddress}, traits::ToField},
    test::helpers::{authwit::add_private_authwit_from_call, txe_oracles},
};
use eclyps_claim_contract::{
    EclypsClaim, ethereum_exit_commitment, ethereum_exit_content, ETHEREUM_EXIT_TAG, exit_content,
};
use eclyps_merkle::{root, vectors as merkle, ZERO_HASHES};
use eclyps_minter_contract::EclypsMinter;
use token::Token;

global HUNDRED: u128 = 100_000_000;
global THOUSAND: u128 = 1_000_000_000;
global C: Field = 0xc0ffee; // an exit commitment

unconstrained fn default_setup() -> Setup {
    setup_with(HUNDRED, crate::EXIT_EPOCH_BLOCKS, crate::MIN_EXIT_BATCH)
}

/// Mints `notes` private notes of the denomination to `who`, as claims would (the setup lists the
/// admin with the minter).
unconstrained fn fund(s: Setup, who: AztecAddress, notes: u32) {
    for _ in 0..notes {
        s.env.call_private(s.admin, EclypsMinter::at(s.minter).mint_to_private(who, s.denomination));
    }
}

/// What the app does: authorize the claim contract to burn one denomination, then exit.
unconstrained fn exit(s: Setup, from: AztecAddress, commitment: Field, nonce: Field) {
    let burn = Token::at(s.token).burn_private(from, s.denomination, nonce);
    add_private_authwit_from_call(s.env, from, s.claim, burn);
    s.env.call_private(from, EclypsClaim::at(s.claim).exit(commitment, nonce));
}

unconstrained fn exit_to_ethereum(s: Setup, from: AztecAddress, commitment: Field, nonce: Field) {
    let burn = Token::at(s.token).burn_private(from, s.denomination, nonce);
    add_private_authwit_from_call(s.env, from, s.claim, burn);
    s.env.call_private(from, EclypsClaim::at(s.claim).exit_to_ethereum(commitment, nonce));
}

/// The public half of `exit` alone, as the claim contract enqueues it. Lets the tree tests append
/// hundreds of leaves without a private burn each.
unconstrained fn append(s: Setup, commitment: Field) {
    s.env.call_public(s.claim, EclypsClaim::at(s.claim)._append_exit(commitment));
}

unconstrained fn close(s: Setup) {
    s.env.call_public(s.claimer, EclypsClaim::at(s.claim).close_exit_epoch());
}

unconstrained fn open_epoch(s: Setup) -> EclypsClaim::ExitEpoch {
    s.env.view_public(EclypsClaim::at(s.claim).get_exit_epoch())
}

unconstrained fn closed(s: Setup, id: u64) -> EclypsClaim::ClosedExitEpoch {
    s.env.view_public(EclypsClaim::at(s.claim).get_closed_exit_epoch(id))
}

unconstrained fn leaves(s: Setup, id: u64) -> BoundedVec<Field, 256> {
    s.env.execute_utility(EclypsClaim::at(s.claim).get_exit_leaves(id))
}

unconstrained fn mine_until(s: Setup, block: u32) {
    while s.env.next_block_number() <= block {
        s.env.mine_block();
    }
}

unconstrained fn supply(s: Setup) -> u128 {
    s.env.view_public(Token::at(s.token).total_supply())
}

/// No field of the last transaction's nullifiers, note hashes or private logs is `who`.
unconstrained fn assert_absent_from_last_tx(who: AztecAddress) {
    let fx = txe_oracles::get_last_tx_effects();
    let a = who.to_field();
    for i in 0..fx.nullifiers.len() {
        assert(fx.nullifiers.get(i) != a, "address in a nullifier");
    }
    for i in 0..fx.note_hashes.len() {
        assert(fx.note_hashes.get(i) != a, "address in a note hash");
    }
    for i in 0..fx.private_logs.len() {
        let log = fx.private_logs.get(i);
        for j in 0..log.len() {
            assert(log.get(j) != a, "address in a private log");
        }
    }
}

// ---------- encodings ----------

/// circuits/vectors/exit.json, generated by Python apart from every implementation; the portal,
/// the SDK and the gateway check the same file.
#[test]
unconstrained fn content_functions_match_the_shared_vectors() {
    for i in 0..4 {
        assert_eq(
            exit_content(
                vectors::EXIT_ROOT[i],
                vectors::EXIT_COUNT[i],
                vectors::EXIT_EPOCH_ID[i],
                vectors::EXIT_DENOMINATION[i],
            ),
            vectors::EXIT_CONTENT[i],
        );
    }
}

/// circuits/vectors/exit-ethereum.json, generated by Python; the portal and the SDK check it too.
#[test]
unconstrained fn ethereum_exit_functions_match_the_shared_vectors() {
    assert_eq(ETHEREUM_EXIT_TAG, vectors::ETH_TAG);
    for i in 0..4 {
        let commitment = ethereum_exit_commitment(
            EthAddress::from_field(vectors::ETH_RECIPIENT[i]),
            vectors::ETH_SECRET[i],
        );
        assert_eq(commitment, vectors::ETH_COMMITMENT[i]);
        assert_eq(
            ethereum_exit_content(commitment, vectors::ETH_DENOMINATION[i]),
            vectors::ETH_CONTENT[i],
        );
    }
}

// ---------- exit (Solana): burn and append ----------

#[test]
unconstrained fn exit_burns_one_denomination_and_appends_the_commitment() {
    let s = default_setup();
    fund(s, s.claimer, 2);
    assert_eq(supply(s), 2 * HUNDRED);

    exit(s, s.claimer, C, 1);

    assert_eq(private_balance(s, s.claimer), HUNDRED);
    assert_eq(supply(s), HUNDRED, "the burned note leaves the supply");
    let e = open_epoch(s);
    assert_eq(e.id, 0);
    assert_eq(e.count, 1);
    let l = leaves(s, 0);
    assert_eq(l.len(), 1);
    assert_eq(l.get(0), C);
}

#[test(should_fail_with = "Unknown auth witness for message hash")]
unconstrained fn exit_without_authwit_fails() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    s.env.call_private(s.claimer, EclypsClaim::at(s.claim).exit(C, 1));
}

/// The burn is always from the caller: another account cannot spend the owner's authwit.
#[test(should_fail_with = "Unknown auth witness for message hash")]
unconstrained fn another_account_cannot_use_the_owners_authwit() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    fund(s, s.recipient, 1);
    let burn = Token::at(s.token).burn_private(s.claimer, HUNDRED, 7);
    add_private_authwit_from_call(s.env, s.claimer, s.claim, burn);
    s.env.call_private(s.recipient, EclypsClaim::at(s.claim).exit(C, 7));
}

#[test(should_fail_with = "Balance too low")]
unconstrained fn exit_without_a_note_fails() {
    let s = default_setup();
    exit(s, s.claimer, C, 1);
}

#[test(should_fail_with = "zero exit commitment")]
unconstrained fn zero_commitment_is_refused() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    exit(s, s.claimer, 0, 1);
}

/// Only the contract itself can append, so the public half of an exit always has the claim
/// contract as its sender, never the account that exited.
#[test(should_fail_with = "can only be called by the same contract")]
unconstrained fn append_is_only_callable_by_the_contract() {
    let s = default_setup();
    s.env.call_public(s.claimer, EclypsClaim::at(s.claim)._append_exit(C));
}

/// What an exit makes public: the leaf (the commitment), the epoch count and the supply. The
/// caller's address is in none of the transaction's nullifiers, note hashes or logs, its public
/// balance stays 0, and the public call is the contract's own (test above).
#[test]
unconstrained fn exit_does_not_reveal_the_caller() {
    let s = default_setup();
    fund(s, s.claimer, 2);
    exit(s, s.claimer, C, 1);
    assert_absent_from_last_tx(s.claimer);
    assert_eq(s.env.view_public(Token::at(s.token).balance_of_public(s.claimer)), 0);
    assert_eq(leaves(s, 0).get(0), C);
}

// ---------- the exit tree ----------

/// Appends leaves into a fresh epoch of `s`, closes it (it must have ended), returns its root.
unconstrained fn close_with<let N: u32>(s: Setup, ls: [Field; N], n: u32) -> Field {
    let id = open_epoch(s).id;
    for i in 0..N {
        if i < n {
            append(s, ls[i]);
        }
    }
    close(s);
    let c = closed(s, id);
    assert_eq(c.count, n);
    assert_eq(open_epoch(s).id, id + 1);
    c.root
}

/// The incremental tree gives the batch tree's root (Rust, TypeScript and Noir agree on these
/// vectors, ADR 0004) for every count from 1 to 16.
#[test]
unconstrained fn tree_root_after_n_exits_equals_the_batch_tree() {
    let s = setup_with(HUNDRED, 1, 1);
    for n in 1..17 {
        let mut prefix = [0; 16];
        for i in 0..16 {
            if i < n {
                prefix[i] = merkle::NOTE_COMMITMENTS[i];
            }
        }
        let r = close_with(s, merkle::NOTE_COMMITMENTS, n);
        assert_eq(r, root::<16, 8>(prefix));
        if n == 11 {
            assert_eq(r, merkle::ROOT_BATCH_FIRST_11);
        }
        if n == 16 {
            assert_eq(r, merkle::ROOT_BATCH_16);
        }
    }
    // One exit: the leaf hashed up with the empty subtrees.
    let mut one = merkle::NOTE_COMMITMENTS[0];
    for h in 0..8 {
        one = eclyps_merkle::hash_pair(one, ZERO_HASHES[h]);
    }
    assert_eq(closed(s, 0).root, one);
}

/// A full tree (256) may close before its end, and its root is the batch tree's.
#[test]
unconstrained fn full_tree_closes_early_with_the_batch_root() {
    let s = setup_with(HUNDRED, 1_000_000, 4);
    let mut ls = [0; 256];
    for i in 0..256 {
        ls[i] = (i as Field + 1) * 0x9e3779b97f4a7c15;
        append(s, ls[i]);
    }
    assert(s.env.next_block_number() < open_epoch(s).ends_at, "not ended");
    close(s);
    let c = closed(s, 0);
    assert_eq(c.count, 256);
    assert_eq(c.root, root::<256, 8>(ls));
    assert_eq(c.content, exit_content(c.root, 256, 0, HUNDRED));
    assert_eq(leaves(s, 0).len(), 256);
    assert_eq(leaves(s, 0).get(255), ls[255]);
}

#[test(should_fail_with = "exit epoch full")]
unconstrained fn a_257th_exit_waits_for_the_close() {
    let s = setup_with(HUNDRED, 1_000_000, 4);
    for i in 0..257 {
        append(s, i as Field + 1);
    }
}

// ---------- close_exit_epoch ----------

/// The exit epoch that holds the three exits the gateway received and paid in LiteSVM, as the
/// eighth epoch of a $1,000 claim contract: its root and the content of its L2->L1 message are
/// exit.json vector 0, which the portal consumes (ExitBatch.t.sol) and burns into the message
/// the gateway accepts.
#[test]
unconstrained fn close_sends_exactly_the_vector_content() {
    let s = setup_with(THOUSAND, 1, 1);
    for id in 0..7 {
        append(s, id as Field + 1);
        close(s);
    }
    assert_eq(open_epoch(s).id, vectors::EXIT_EPOCH_ID[0]);
    fund(s, s.claimer, 3);
    for i in 0..3 {
        exit(s, s.claimer, vectors::FIXTURE_LEAVES[i], i as Field);
    }
    let before = s.env.next_block_number();
    close(s);

    let c = closed(s, 7);
    assert_eq(c.count, vectors::EXIT_COUNT[0]);
    assert_eq(c.root, vectors::EXIT_ROOT[0]);
    assert_eq(c.content, vectors::EXIT_CONTENT[0]);
    assert_eq(c.closed_at, before);
    let l = leaves(s, 7);
    assert_eq(l.len(), 3);
    for i in 0..3 {
        assert_eq(l.get(i), vectors::FIXTURE_LEAVES[i]);
    }
    let e = open_epoch(s);
    assert_eq(e.id, 8);
    assert_eq(e.count, 0);
    assert_eq(e.ends_at, before + 1);
    assert_eq(private_balance(s, s.claimer), 0);
}

/// Below `min_exit_batch` the epoch rolls over: same id, same exits, a new end, no message.
#[test]
unconstrained fn fewer_than_min_rolls_over_then_closes() {
    let s = default_setup(); // 10 blocks, at least 4 exits
    fund(s, s.claimer, 4);
    for i in 0..3 {
        exit(s, s.claimer, C + i as Field, i as Field);
    }
    let first = open_epoch(s);
    mine_until(s, first.ends_at);
    let at = s.env.next_block_number();
    close(s);

    let rolled = open_epoch(s);
    assert_eq(rolled.id, 0, "same epoch");
    assert_eq(rolled.count, 3, "its exits kept");
    assert_eq(rolled.ends_at, at + crate::EXIT_EPOCH_BLOCKS);
    assert_eq(closed(s, 0).count, 0, "nothing sent");

    exit(s, s.claimer, C + 3, 3);
    mine_until(s, rolled.ends_at);
    close(s);
    let c = closed(s, 0);
    assert_eq(c.count, 4);
    let mut four = [0; 4];
    for i in 0..4 {
        four[i] = C + i as Field;
    }
    assert_eq(c.root, root::<4, 8>(four));
    assert_eq(c.content, exit_content(c.root, 4, 0, HUNDRED));
    assert_eq(open_epoch(s).id, 1);
}

#[test(should_fail_with = "exit epoch still open")]
unconstrained fn close_before_the_end_fails() {
    let s = setup_with(HUNDRED, 1000, 4);
    fund(s, s.claimer, 4);
    for i in 0..4 {
        exit(s, s.claimer, C + i as Field, i as Field);
    }
    assert(s.env.next_block_number() < open_epoch(s).ends_at);
    close(s);
}

/// A closed epoch cannot be sent twice: the next close finds the new, empty epoch still open.
#[test(should_fail_with = "exit epoch still open")]
unconstrained fn double_close_is_refused() {
    let s = setup_with(HUNDRED, 5, 1);
    append(s, C);
    mine_until(s, open_epoch(s).ends_at);
    close(s);
    assert_eq(closed(s, 0).count, 1);
    close(s);
}

// ---------- constructor ----------

#[test(should_fail_with = "bad min_exit_batch")]
unconstrained fn min_exit_batch_zero_is_refused() {
    let _ = setup_with(HUNDRED, 10, 0);
}

#[test(should_fail_with = "bad min_exit_batch")]
unconstrained fn min_exit_batch_over_256_is_refused() {
    let _ = setup_with(HUNDRED, 10, 257);
}

#[test(should_fail_with = "bad exit_epoch_blocks")]
unconstrained fn zero_exit_epoch_blocks_is_refused() {
    let _ = setup_with(HUNDRED, 0, 4);
}

/// 256 x denomination must fit the u64 the portal burns and Solana pays.
#[test(should_fail_with = "bad denomination")]
unconstrained fn denomination_whose_full_epoch_overflows_u64_is_refused() {
    let _ = setup_with(1 << 56, 10, 4);
}

// ---------- exit_to_ethereum ----------

#[test]
unconstrained fn exit_to_ethereum_burns_one_denomination_and_hides_the_caller() {
    let s = default_setup();
    fund(s, s.claimer, 2);
    let commitment = ethereum_exit_commitment(EthAddress::from_field(0xbeef), 42);
    exit_to_ethereum(s, s.claimer, commitment, 1);

    assert_eq(private_balance(s, s.claimer), HUNDRED);
    assert_eq(supply(s), HUNDRED);
    assert_absent_from_last_tx(s.claimer);
    assert_eq(s.env.view_public(Token::at(s.token).balance_of_public(s.claimer)), 0);
    // It is not a Solana exit: the exit tree is untouched.
    assert_eq(open_epoch(s).count, 0);
}

#[test(should_fail_with = "Unknown auth witness for message hash")]
unconstrained fn exit_to_ethereum_without_authwit_fails() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    s.env.call_private(s.claimer, EclypsClaim::at(s.claim).exit_to_ethereum(C, 1));
}

#[test(should_fail_with = "Unknown auth witness for message hash")]
unconstrained fn exit_to_ethereum_cannot_use_another_accounts_authwit() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    fund(s, s.recipient, 1);
    let burn = Token::at(s.token).burn_private(s.claimer, HUNDRED, 7);
    add_private_authwit_from_call(s.env, s.claimer, s.claim, burn);
    s.env.call_private(s.recipient, EclypsClaim::at(s.claim).exit_to_ethereum(C, 7));
}

#[test(should_fail_with = "zero exit commitment")]
unconstrained fn exit_to_ethereum_refuses_a_zero_commitment() {
    let s = default_setup();
    fund(s, s.claimer, 1);
    exit_to_ethereum(s, s.claimer, 0, 1);
}
